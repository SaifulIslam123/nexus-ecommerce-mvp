# ============================================================
# Environment Variables – copy this file to .env and fill in
# NEVER commit .env to version control!
# ============================================================

# ── Spring Profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:mysql://<host>:3306/ecommerce?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
DB_SCHEMA=ecommerce

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=<redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_SSL_ENABLED=true

# ── JWT ──────────────────────────────────────────────────────
# Generate a secure 256-bit Base64 key, e.g.:
#   openssl rand -base64 32
JWT_SECRET=<your-base64-encoded-256-bit-secret>
JWT_EXPIRATION_MS=36000000

# ── Server ───────────────────────────────────────────────────
PORT=8080
MANAGEMENT_PORT=8081

